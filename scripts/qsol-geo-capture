#!/bin/bash -p
set -euo pipefail

# POSIX installed qsol-geo-capture trust boundary.  Python starts only after
# ambient Python/native-loader controls have been cleared, and always under
# isolated/no-site/no-bytecode flags.
for qsol_name in ${!PYTHON@} ${!LD_@} ${!DYLD_@} ${!_RLD_@} ${!LDR_@}; do
    unset "$qsol_name" || {
        printf '%s\n' "qsol-geo-capture: unable to clear pre-interpreter environment control $qsol_name" >&2
        exit 126
    }
done
for qsol_name in GLIBC_TUNABLES LIBPATH SHLIB_PATH; do
    if [[ -v $qsol_name ]]; then
        unset "$qsol_name" || {
            printf '%s\n' "qsol-geo-capture: unable to clear pre-interpreter loader control $qsol_name" >&2
            exit 126
        }
    fi
done

qsol_script=$0
case "$qsol_script" in
    /*) ;;
    *) qsol_script="$PWD/${qsol_script#./}" ;;
esac
qsol_bindir=${qsol_script%/*}
qsol_python="$qsol_bindir/python"
if [[ ! -f $qsol_python || ! -x $qsol_python ]]; then
    qsol_python="$qsol_bindir/python3"
fi
if [[ $qsol_python != /* || ! -f $qsol_python || ! -x $qsol_python ]]; then
    printf '%s\n' "qsol-geo-capture: installed command requires an adjacent executable Python interpreter" >&2
    exit 126
fi

exec "$qsol_python" -I -S -B - "$qsol_script" "$@" <<'QSOL_STANDALONE_STAGE0'
from __future__ import annotations

import hashlib
import importlib.metadata
import json
import os
import pathlib
import re
import stat
import subprocess
import sys
import sysconfig
import urllib.parse
import urllib.request

if not sys.flags.isolated or not sys.flags.no_site or not sys.flags.no_user_site or not sys.flags.ignore_environment or not sys.dont_write_bytecode:
    raise RuntimeError("qsol-geo-capture standalone stage0 requires CPython -I -S -B")

wrapper = pathlib.Path(sys.argv[1])
loader_prefixes = ("LD_", "DYLD_", "_RLD_", "LDR_")
loader_names = {"GLIBC_TUNABLES", "LIBPATH", "SHLIB_PATH"}


def literal_site_package_paths() -> tuple[pathlib.Path, ...]:
    executable = pathlib.Path(sys.executable).resolve(strict=True)
    venv_root = executable.parent.parent
    candidates: list[pathlib.Path] = []
    if (venv_root / "pyvenv.cfg").is_file():
        version = f"python{sys.version_info.major}.{sys.version_info.minor}"
        candidates.extend(
            (
                venv_root / "lib" / version / "site-packages",
                venv_root / "lib64" / version / "site-packages",
            )
        )
    else:
        for key in ("purelib", "platlib"):
            value = sysconfig.get_paths().get(key)
            if isinstance(value, str) and value.strip():
                candidates.append(pathlib.Path(value))
    observed: list[pathlib.Path] = []
    for candidate in candidates:
        resolved = candidate.resolve(strict=False)
        if resolved.is_dir() and resolved not in observed:
            observed.append(resolved)
    if not observed:
        raise RuntimeError("unable to locate installed distribution metadata without site startup")
    return tuple(observed)


def canonical_distribution_name(value: str) -> str:
    return re.sub(r"[-_.]+", "-", value).lower()


def editable_checkout_root() -> pathlib.Path:
    roots: set[pathlib.Path] = set()
    for site_path in literal_site_package_paths():
        for distribution in importlib.metadata.distributions(path=[str(site_path)]):
            name = distribution.metadata.get("Name", "")
            if canonical_distribution_name(name) != "qsol-geo-reason":
                continue
            raw = distribution.read_text("direct_url.json")
            if raw is None:
                raise RuntimeError("qsol-geo-capture requires an editable qsol-geo-reason install to locate its authenticated checkout")
            record = json.loads(raw)
            if record.get("dir_info", {}).get("editable") is not True:
                raise RuntimeError("qsol-geo-capture requires an editable qsol-geo-reason install to bind source provenance")
            parsed = urllib.parse.urlsplit(record.get("url", ""))
            if parsed.scheme.lower() != "file" or parsed.netloc not in {"", "localhost"}:
                raise RuntimeError("editable qsol-geo-reason direct_url must be a local file URL")
            decoded = urllib.request.url2pathname(urllib.parse.unquote(parsed.path))
            roots.add(pathlib.Path(decoded).resolve(strict=True))
    if len(roots) != 1:
        raise RuntimeError("qsol-geo-capture could not identify exactly one editable QSOL-GEO-REASON checkout")
    return next(iter(roots))


def hash_executable(candidate: pathlib.Path) -> tuple[pathlib.Path, str]:
    resolved = candidate.resolve(strict=True)
    info = resolved.stat()
    if not stat.S_ISREG(info.st_mode) or not os.access(resolved, os.X_OK):
        raise RuntimeError(f"untrusted standalone Git executable {resolved}")
    if os.name == "posix" and (info.st_uid != 0 or info.st_mode & (stat.S_IWGRP | stat.S_IWOTH)):
        raise RuntimeError(f"untrusted standalone Git executable metadata {resolved}")
    return resolved, hashlib.sha256(resolved.read_bytes()).hexdigest()


last_error: BaseException | None = None
git_identity: tuple[pathlib.Path, str] | None = None
for candidate in (
    pathlib.Path("/usr/bin/git"),
    pathlib.Path("/bin/git"),
    pathlib.Path("/run/current-system/sw/bin/git"),
):
    try:
        git_identity = hash_executable(candidate)
        break
    except (OSError, RuntimeError) as exc:
        last_error = exc
if git_identity is None:
    raise RuntimeError("qsol-geo-capture requires a trusted system Git executable") from last_error
git, git_digest = git_identity
root = editable_checkout_root()

environment: dict[str, str] = {}
for key, value in os.environ.items():
    upper = key.upper()
    if upper == "PATH" or upper.startswith("GIT_") or upper.startswith("PYTHON"):
        continue
    if upper.startswith(loader_prefixes) or upper in loader_names:
        continue
    environment[key] = value
environment.update(
    {
        "PATH": "/usr/bin:/bin:/run/current-system/sw/bin",
        "LC_ALL": "C",
        "GIT_NO_REPLACE_OBJECTS": "1",
        "GIT_CONFIG_NOSYSTEM": "1",
        "GIT_CONFIG_GLOBAL": os.devnull,
        "GIT_OPTIONAL_LOCKS": "0",
        "GIT_TERMINAL_PROMPT": "0",
    }
)


def git_run(*args: str) -> bytes:
    completed = subprocess.run(
        [str(git), "-C", str(root), *args],
        env=environment,
        check=True,
        capture_output=True,
    )
    observed_git, observed_digest = hash_executable(git)
    if observed_git != git or observed_digest != git_digest:
        raise RuntimeError("trusted Git executable changed during standalone stage0")
    return completed.stdout


commit = git_run("rev-parse", "--verify", "HEAD^{commit}").decode("ascii").strip()
if len(commit) != 40 or any(ch not in "0123456789abcdef" for ch in commit):
    raise RuntimeError("standalone stage0 could not bind a lowercase 40-hex Git commit")

committed_wrapper = git_run("cat-file", "blob", commit + ":scripts/qsol-geo-capture")
if wrapper.read_bytes() != committed_wrapper:
    raise RuntimeError("installed qsol-geo-capture wrapper does not match the bound Git revision")

payload = git_run("cat-file", "blob", commit + ":scripts/qsol-geo-capture-python")
if git_run("rev-parse", "--verify", "HEAD^{commit}").decode("ascii").strip() != commit:
    raise RuntimeError("Git HEAD changed while authenticating the standalone capture payload")

sys.argv = [str(wrapper), *sys.argv[2:]]
namespace = {
    "__name__": "qsol_standalone_authenticated_payload",
    "__file__": str(wrapper),
    "__package__": None,
    "_QSOL_STANDALONE_AUTHENTICATED_ROOT": str(root),
    "_QSOL_STANDALONE_BOOTSTRAP_GIT_PATH": "scripts/qsol-geo-capture",
}
exec(compile(payload, str(wrapper), "exec"), namespace, namespace)
raise SystemExit(namespace["main"]())
QSOL_STANDALONE_STAGE0
