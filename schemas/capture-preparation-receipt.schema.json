{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-GEO-REASON/schemas/capture-preparation-receipt.schema.json",
  "title": "QSOL-GEO-REASON GEO-CAP-001 preparation provenance receipt",
  "description": "Binds the finalized request produced by the online trusted preparation phase to the clean QSOL-GEO-REASON repository revision and canonical Hugging Face endpoint that produced its authenticated Hub-tree receipts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "experiment_id",
    "preparation_repository_commit",
    "hub_endpoint",
    "request_sha256",
    "model_repository",
    "model_revision",
    "tokenizer_repository",
    "tokenizer_revision",
    "revision_tree_sha256",
    "tokenizer_revision_tree_sha256",
    "preparation_receipt_sha256"
  ],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_id": {"const": "GEO-CAP-001"},
    "experiment_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "preparation_repository_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "hub_endpoint": {"const": "https://huggingface.co"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "model_repository": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "model_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "tokenizer_repository": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "tokenizer_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "revision_tree_sha256": {"$ref": "#/$defs/sha256"},
    "tokenizer_revision_tree_sha256": {"$ref": "#/$defs/sha256"},
    "preparation_receipt_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
