{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-GEO-REASON/schemas/capture-request.schema.json",
  "title": "QSOL-GEO-REASON GEO-CAP-001 canonical capture request",
  "description": "Structural schema for GEO-CAP-001. Canonical acceptance additionally requires the repository semantic validator because JSON Schema draft 2020-12 cannot express uniqueness by the step_id property across an array of step objects.",
  "x-qsol-semantic-validation": {
    "required": true,
    "command": "qsol-geo-capture --validate-only REQUEST.json",
    "constraints": ["steps[].step_id must be unique"]
  },
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "run_id", "model", "backend", "capture", "determinism", "generation_parameters", "steps"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_id": {"const": "GEO-CAP-001"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "model": {"$ref": "#/$defs/model"},
    "backend": {"$ref": "#/$defs/backend"},
    "capture": {"$ref": "#/$defs/capture"},
    "determinism": {"$ref": "#/$defs/determinism"},
    "generation_parameters": {"$ref": "#/$defs/generationParameters"},
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/step"},
      "description": "Ordered steps. step_id uniqueness is a required semantic constraint enforced by the canonical post-schema validator declared in x-qsol-semantic-validation."
    },
    "notes": {"type": "string"}
  },
  "$defs": {
    "gitSha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "hubRepoId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_])?/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_])?$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "revision", "revision_kind", "tokenizer_identifier", "tokenizer_revision", "tokenizer_revision_kind"],
      "properties": {
        "identifier": {"$ref": "#/$defs/hubRepoId"},
        "revision": {"$ref": "#/$defs/gitSha"},
        "revision_kind": {"const": "hf_commit"},
        "tokenizer_identifier": {"$ref": "#/$defs/hubRepoId"},
        "tokenizer_revision": {"$ref": "#/$defs/gitSha"},
        "tokenizer_revision_kind": {"const": "hf_commit"}
      }
    },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "local_files_only", "trust_remote_code", "device", "dtype", "quantization"],
      "properties": {
        "name": {"const": "huggingface-pytorch"},
        "local_files_only": {"const": true},
        "trust_remote_code": {"const": false},
        "device": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "dtype": {"enum": ["float32", "float16", "bfloat16"]},
        "quantization": {"const": "none"}
      }
    },
    "pooling": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["last_token", "step_mean", "context_mean"]}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "window_tokens"], "properties": {"mode": {"const": "bounded_context_mean"}, "window_tokens": {"type": "integer", "minimum": 1}}}
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_mode", "phase", "layers", "pooling", "prefix_text", "step_joiner"],
      "properties": {
        "context_mode": {"enum": ["cumulative", "isolated"]},
        "phase": {"const": "replayed_prefix"},
        "layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "pooling": {"$ref": "#/$defs/pooling"},
        "prefix_text": {"type": "string"},
        "step_joiner": {"type": "string"}
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "seed"],
      "properties": {"mode": {"enum": ["required", "best_effort"]}, "seed": {"type": "integer", "minimum": 0}}
    },
    "generationParameters": {
      "type": "object",
      "required": ["generation_used"],
      "properties": {"generation_used": {"const": false}},
      "additionalProperties": {"type": "null"}
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_id", "text"],
      "properties": {
        "step_id": {"type": "string", "minLength": 1, "pattern": "\\S"},
        "text": {"type": "string", "minLength": 1, "pattern": "\\S"}
      }
    }
  }
}
