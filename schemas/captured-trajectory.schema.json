{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-GEO-REASON/schemas/captured-trajectory.schema.json",
  "title": "QSOL-GEO-REASON GEO-CAP-001 captured representation trajectory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "evidence_class", "replication_status", "run_id", "run_manifest_id", "repository_commit", "representation_definition", "steps", "trajectory_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_id": {"const": "GEO-CAP-001"},
    "evidence_class": {"enum": ["SIMULATION", "OBSERVATION"]},
    "replication_status": {"const": "not_attempted"},
    "run_id": {"type": "string", "minLength": 1},
    "run_manifest_id": {"$ref": "#/$defs/sha256"},
    "repository_commit": {"$ref": "#/$defs/gitSha"},
    "representation_definition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_mode", "phase", "layers", "layer_index_semantics", "pooling", "step_span_semantics"],
      "properties": {
        "context_mode": {"enum": ["cumulative", "isolated"]},
        "phase": {"const": "replayed_prefix"},
        "layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "layer_index_semantics": {"type": "string", "minLength": 1},
        "pooling": {"$ref": "#/$defs/pooling"},
        "step_span_semantics": {"type": "string", "minLength": 1}
      }
    },
    "steps": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/step"}},
    "trajectory_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "pooling": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["last_token", "step_mean", "context_mean"]}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "window_tokens"], "properties": {"mode": {"const": "bounded_context_mean"}, "window_tokens": {"type": "integer", "minimum": 1}}}
      ]
    },
    "span": {
      "type": "array",
      "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 1}],
      "minItems": 2,
      "maxItems": 2
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["layer_index", "vector_dimension", "observed_dtype", "pool_span", "vector", "vector_sha256"],
      "properties": {
        "layer_index": {"type": "integer", "minimum": 0},
        "vector_dimension": {"type": "integer", "minimum": 1},
        "observed_dtype": {"type": "string", "minLength": 1},
        "pool_span": {"$ref": "#/$defs/span"},
        "vector": {"type": "array", "minItems": 1, "items": {"type": "number"}},
        "vector_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step_index", "step_id", "rendered_text_sha256", "input_ids", "input_ids_sha256", "token_count", "changed_token_span", "phase", "layers"],
      "properties": {
        "step_index": {"type": "integer", "minimum": 0},
        "step_id": {"type": "string", "minLength": 1},
        "rendered_text_sha256": {"$ref": "#/$defs/sha256"},
        "input_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "input_ids_sha256": {"$ref": "#/$defs/sha256"},
        "token_count": {"type": "integer", "minimum": 1},
        "changed_token_span": {"$ref": "#/$defs/span"},
        "phase": {"const": "replayed_prefix"},
        "layers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/layer"}}
      }
    }
  }
}
