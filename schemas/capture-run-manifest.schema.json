{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/QSOLKCB/QSOL-GEO-REASON/schemas/capture-run-manifest.schema.json",
  "title": "QSOL-GEO-REASON GEO-CAP-001 run manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "protocol_id", "run_id", "repository_commit", "request_sha256", "model", "backend_request", "backend_observed", "capture", "determinism", "generation_parameters", "run_manifest_id", "artifacts", "manifest_sha256"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "protocol_id": {"const": "GEO-CAP-001"},
    "run_id": {"type": "string", "minLength": 1},
    "repository_commit": {"$ref": "#/$defs/gitSha"},
    "request_sha256": {"$ref": "#/$defs/sha256"},
    "model": {"$ref": "#/$defs/model"},
    "backend_request": {"$ref": "#/$defs/backendRequest"},
    "backend_observed": {"$ref": "#/$defs/backendObserved"},
    "capture": {"$ref": "#/$defs/capture"},
    "determinism": {"$ref": "#/$defs/determinism"},
    "generation_parameters": {"$ref": "#/$defs/generationParameters"},
    "run_manifest_id": {"$ref": "#/$defs/sha256"},
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capture_request_sha256", "captured_trajectory_sha256"],
      "properties": {
        "capture_request_sha256": {"$ref": "#/$defs/sha256"},
        "captured_trajectory_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "manifest_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "gitSha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nullableString": {"type": ["string", "null"]},
    "nullableInteger": {"type": ["integer", "null"]},
    "hubRepoId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 96,
      "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_])?/[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_])?$"
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identifier", "revision", "revision_kind", "tokenizer_identifier", "tokenizer_revision", "tokenizer_revision_kind"],
      "properties": {
        "identifier": {"$ref": "#/$defs/hubRepoId"},
        "revision": {"$ref": "#/$defs/gitSha"},
        "revision_kind": {"const": "hf_commit"},
        "tokenizer_identifier": {"$ref": "#/$defs/hubRepoId"},
        "tokenizer_revision": {"$ref": "#/$defs/gitSha"},
        "tokenizer_revision_kind": {"const": "hf_commit"}
      }
    },
    "backendRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "local_files_only", "trust_remote_code", "device", "dtype", "quantization"],
      "properties": {
        "name": {"const": "huggingface-pytorch"},
        "local_files_only": {"const": true},
        "trust_remote_code": {"const": false},
        "device": {"type": "string", "minLength": 1},
        "dtype": {"enum": ["float32", "float16", "bfloat16"]},
        "quantization": {"const": "none"}
      }
    },
    "pooling": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["mode"], "properties": {"mode": {"enum": ["last_token", "step_mean", "context_mean"]}}},
        {"type": "object", "additionalProperties": false, "required": ["mode", "window_tokens"], "properties": {"mode": {"const": "bounded_context_mean"}, "window_tokens": {"type": "integer", "minimum": 1}}}
      ]
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["context_mode", "phase", "layers", "pooling", "prefix_text", "step_joiner"],
      "properties": {
        "context_mode": {"enum": ["cumulative", "isolated"]},
        "phase": {"const": "replayed_prefix"},
        "layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "pooling": {"$ref": "#/$defs/pooling"},
        "prefix_text": {"type": "string"},
        "step_joiner": {"type": "string"}
      }
    },
    "determinism": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "seed"],
      "properties": {"mode": {"enum": ["required", "best_effort"]}, "seed": {"type": "integer", "minimum": 0}}
    },
    "generationParameters": {
      "type": "object",
      "required": ["generation_used"],
      "properties": {"generation_used": {"const": false}},
      "additionalProperties": {"type": "null"}
    },
    "backendObserved": {
      "oneOf": [
        {"$ref": "#/$defs/backendObservedProduction"},
        {"$ref": "#/$defs/backendObservedSimulation"}
      ]
    },
    "backendObservedSimulation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "observed_model_commit",
        "observed_tokenizer_commit",
        "device",
        "dtype",
        "quantization",
        "local_files_only",
        "trust_remote_code",
        "use_cache",
        "capture_phase",
        "kv_cache_reuse",
        "determinism_mode"
      ],
      "properties": {
        "name": {"const": "huggingface-pytorch"},
        "observed_model_commit": {"$ref": "#/$defs/gitSha"},
        "observed_tokenizer_commit": {"$ref": "#/$defs/gitSha"},
        "device": {"type": "string", "minLength": 1},
        "dtype": {"type": "string", "minLength": 1},
        "quantization": {"const": "none"},
        "local_files_only": {"const": true},
        "trust_remote_code": {"const": false},
        "use_cache": {"const": false},
        "capture_phase": {"const": "replayed_prefix"},
        "kv_cache_reuse": {"const": false},
        "determinism_mode": {"enum": ["required", "best_effort"]}
      }
    },
    "backendObservedProduction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "python_version",
        "platform",
        "torch_version",
        "transformers_version",
        "tokenizers_version",
        "huggingface_hub_version",
        "model_class",
        "tokenizer_class",
        "observed_model_commit",
        "observed_tokenizer_commit",
        "checkpoint_loading_clean",
        "quantization_config_present",
        "model_reports_quantized",
        "attention_implementation",
        "device",
        "cpu_machine",
        "cpu_processor",
        "cpu_instruction_flags",
        "torch_num_threads",
        "torch_num_interop_threads",
        "omp_num_threads",
        "mkl_num_threads",
        "cuda_device_name",
        "cuda_device_capability",
        "cuda_build_version",
        "cudnn_version",
        "nvidia_driver_version",
        "dtype",
        "observed_hidden_state_dtypes",
        "pool_accumulation_dtype",
        "pool_accumulation_device",
        "hidden_state_capture_strategy",
        "hidden_state_block_path",
        "hidden_state_count",
        "quantization",
        "offloading",
        "local_files_only",
        "trust_remote_code",
        "use_cache",
        "capture_phase",
        "kv_cache_reuse",
        "deterministic_algorithms_enabled",
        "determinism_mode"
      ],
      "properties": {
        "name": {"const": "huggingface-pytorch"},
        "python_version": {"type": "string", "minLength": 1},
        "platform": {"type": "string", "minLength": 1},
        "torch_version": {"type": "string", "minLength": 1},
        "transformers_version": {"type": "string", "minLength": 1},
        "tokenizers_version": {"$ref": "#/$defs/nullableString"},
        "huggingface_hub_version": {"$ref": "#/$defs/nullableString"},
        "model_class": {"type": "string", "minLength": 1},
        "tokenizer_class": {"type": "string", "minLength": 1},
        "observed_model_commit": {"$ref": "#/$defs/gitSha"},
        "observed_tokenizer_commit": {"$ref": "#/$defs/gitSha"},
        "checkpoint_loading_clean": {"const": true},
        "quantization_config_present": {"const": false},
        "model_reports_quantized": {"const": false},
        "attention_implementation": {"$ref": "#/$defs/nullableString"},
        "device": {"type": "string", "minLength": 1},
        "cpu_machine": {"$ref": "#/$defs/nullableString"},
        "cpu_processor": {"$ref": "#/$defs/nullableString"},
        "cpu_instruction_flags": {"$ref": "#/$defs/nullableString"},
        "torch_num_threads": {"$ref": "#/$defs/nullableInteger"},
        "torch_num_interop_threads": {"$ref": "#/$defs/nullableInteger"},
        "omp_num_threads": {"$ref": "#/$defs/nullableString"},
        "mkl_num_threads": {"$ref": "#/$defs/nullableString"},
        "cuda_device_name": {"$ref": "#/$defs/nullableString"},
        "cuda_device_capability": {"$ref": "#/$defs/nullableString"},
        "cuda_build_version": {"$ref": "#/$defs/nullableString"},
        "cudnn_version": {"$ref": "#/$defs/nullableInteger"},
        "nvidia_driver_version": {"$ref": "#/$defs/nullableString"},
        "dtype": {"enum": ["float32", "float16", "bfloat16"]},
        "observed_hidden_state_dtypes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "pool_accumulation_dtype": {"const": "float64"},
        "pool_accumulation_device": {"const": "cpu"},
        "hidden_state_capture_strategy": {"const": "selective_forward_hooks"},
        "hidden_state_block_path": {"enum": ["layers", "h", "decoder.layers", "transformer.h", "gpt_neox.layers"]},
        "hidden_state_count": {"type": "integer", "minimum": 2},
        "quantization": {"const": "none"},
        "offloading": {"const": "none"},
        "local_files_only": {"const": true},
        "trust_remote_code": {"const": false},
        "use_cache": {"const": false},
        "capture_phase": {"const": "replayed_prefix"},
        "kv_cache_reuse": {"const": false},
        "deterministic_algorithms_enabled": {"type": "boolean"},
        "determinism_mode": {"enum": ["required", "best_effort"]}
      }
    }
  }
}
